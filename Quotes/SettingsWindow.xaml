<Window x:Class="Quotes.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="500" Height="210"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quotes Folder -->
        <TextBlock Grid.Row="0" Text="Quotes folder:" FontSize="13" Foreground="#444" Margin="0,0,0,6"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderTextBox"
                     Grid.Column="0"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Padding="6,0"
                     FontSize="13"
                     Margin="0,0,6,0"/>
            <Button Grid.Column="1"
                    Content="Browse…"
                    Width="84" Height="30"
                    FontSize="13"
                    Click="BrowseButton_Click"/>
        </Grid>

        <!-- Startup checkbox -->
        <CheckBox x:Name="StartupCheckBox"
                  Grid.Row="2"
                  Content="Run automatically at Windows startup"
                  FontSize="13"
                  Foreground="#444"
                  Margin="0,0,0,0"/>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="OK"
                    Width="80" Height="30"
                    FontSize="13"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Width="80" Height="30"
                    FontSize="13"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
